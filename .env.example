# ─────────────────────────────────────────────────────────────
# Configuration EmailJS — formulaire de contact
# ─────────────────────────────────────────────────────────────
# 1. Créez un compte sur https://www.emailjs.com
# 2. Ajoutez un "Email Service" (ex: Gmail relié à kalebadagbe@gmail.com)
#    -> copiez son "Service ID" dans NEXT_PUBLIC_EMAILJS_SERVICE_ID
# 3. Créez un "Email Template" avec les variables {{name}}, {{email}},
#    {{phone}}, {{service}}, {{message}} (elles correspondent aux
#    champs "name", "email", "phone", "service", "message" du
#    formulaire dans app/contact/ContactForm.tsx)
#    -> copiez son "Template ID" dans NEXT_PUBLIC_EMAILJS_TEMPLATE_ID
# 4. Dans "Account" > "General", copiez votre "Public Key"
#    -> collez-la dans NEXT_PUBLIC_EMAILJS_PUBLIC_KEY
#
# Copiez ce fichier en ".env.local" (non versionné) et renseignez
# les trois valeurs ci-dessous avant de lancer "npm run dev" ou de
# déployer sur Vercel (renseignez les mêmes variables dans
# Project Settings > Environment Variables sur vercel.com).
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_EMAILJS_SERVICE_ID=votre_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=votre_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=votre_public_key
